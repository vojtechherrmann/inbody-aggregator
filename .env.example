# Local development settings -- copy to .env (gitignored) and adjust. Secrets never go here:
# they live in .apikeys/ (gitignored) or, in Azure, in Container App secrets.
APP_ENV=dev
SQL_BACKEND=sqlite
STORAGE_BACKEND=local
CONTACT_EMAIL=herrmann.vojtech@gmail.com
# SESSION_SECRET=...            # optional locally (a random per-process key is used if unset)
# INBODY_NTFY_TOPIC=...         # a credential: keep it in .apikeys/ntfy.env, empty = no pushes
# ANTHROPIC_API_KEY=...         # only for sheet uploads; keep it in .apikeys/anthropic.env
WORKER_ENABLED=1
